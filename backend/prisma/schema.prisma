// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  FINANCE_ANALYST
  OPERATIONS_USER
  VIEWER
}

enum PolicyType {
  AUTO
  HOME
  HEALTH
  LIFE
  COMMERCIAL
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  OVERPAID
  CANCELLED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  AUTO_DEBIT
  CHEQUE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationStatus {
  MATCHED
  UNDERPAYMENT
  OVERPAYMENT
  MISSING_PAYMENT
  DUPLICATE_PAYMENT
  LATE_PAYMENT
  PAYMENT_FAILED
}

enum ExceptionType {
  UNDERPAYMENT
  OVERPAYMENT
  MISSING_PAYMENT
  DUPLICATE_PAYMENT
  LATE_PAYMENT
  PAYMENT_FAILED
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ESCALATED
}

enum TimelineEventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
  AI_ANALYSIS
  RESOLVED
  ESCALATED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_EXCEPTION
  ASSIGN_EXCEPTION
  UPDATE_EXCEPTION
  ADD_NOTE
  RESOLVE_EXCEPTION
  RUN_RECONCILIATION
  AI_ANALYSIS
}

enum AIAnalysisType {
  EXCEPTION_ANALYSIS
  INVESTIGATION_SUMMARY
  DASHBOARD_INSIGHT
}

enum AIMessageRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  assignedExceptions  PaymentException[] @relation("AssignedExceptions")
  exceptionNotes      ExceptionNote[]
  timelineEvents      ExceptionTimelineEvent[]
  auditLogs           AuditLog[]
  aiConversations     AIConversation[]

  @@map("users")
}

model Policyholder {
  id             String   @id @default(cuid())
  customerNumber String   @unique
  name           String
  email          String   @unique
  phone          String
  address        String
  city           String
  state          String
  postalCode     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  policies       Policy[]
  billingAccounts BillingAccount[]

  @@map("policyholders")
}

model Policy {
  id               String           @id @default(cuid())
  policyNumber     String           @unique
  policyholderId   String
  policyType       PolicyType
  premiumAmount    Decimal          @db.Decimal(12, 2)
  billingFrequency BillingFrequency
  effectiveDate    DateTime
  expirationDate   DateTime
  status           PolicyStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  policyholder     Policyholder     @relation(fields: [policyholderId], references: [id], onDelete: Cascade)
  billingAccounts  BillingAccount[]
  invoices         Invoice[]
  payments         Payment[]
  exceptions       PaymentException[]
  reconciliationRecords ReconciliationRecord[]

  @@map("policies")
}

model BillingAccount {
  id             String   @id @default(cuid())
  accountNumber  String   @unique
  policyholderId String
  policyId       String
  balance        Decimal  @db.Decimal(12, 2) @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  policyholder   Policyholder @relation(fields: [policyholderId], references: [id], onDelete: Cascade)
  policy         Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@map("billing_accounts")
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  billingAccountId String
  policyId         String
  dueDate          DateTime
  premiumAmount    Decimal       @db.Decimal(12, 2)
  taxAmount        Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount      Decimal       @db.Decimal(12, 2)
  status           InvoiceStatus @default(UNPAID)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  billingAccount   BillingAccount  @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  policy           Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  payments         Payment[]
  exceptions       PaymentException[]
  reconciliationRecords ReconciliationRecord[]

  @@map("invoices")
}

model Payment {
  id              String        @id @default(cuid())
  transactionId   String        @unique
  invoiceId       String
  policyId        String
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime
  paymentMethod   PaymentMethod
  status          PaymentStatus
  referenceNumber String?
  gatewayResponse String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  policy          Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
  exceptions      PaymentException[]
  reconciliationRecords ReconciliationRecord[]

  @@map("payments")
}

model ReconciliationRun {
  id                  String                  @id @default(cuid())
  runNumber           String                  @unique
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  recordsProcessed    Int                     @default(0)
  matchedRecords      Int                     @default(0)
  exceptionRecords    Int                     @default(0)
  totalExpectedAmount Decimal                 @db.Decimal(14, 2) @default(0)
  totalReceivedAmount Decimal                 @db.Decimal(14, 2) @default(0)
  totalDifference     Decimal                 @db.Decimal(14, 2) @default(0)
  status              ReconciliationRunStatus @default(RUNNING)
  createdAt           DateTime                @default(now())

  // Relations
  records             ReconciliationRecord[]

  @@map("reconciliation_runs")
}

model ReconciliationRecord {
  id             String               @id @default(cuid())
  runId          String
  invoiceId      String
  policyId       String
  paymentId      String?
  expectedAmount Decimal              @db.Decimal(12, 2)
  actualAmount   Decimal              @db.Decimal(12, 2)
  difference     Decimal              @db.Decimal(12, 2)
  status         ReconciliationStatus
  exceptionId    String?
  createdAt      DateTime             @default(now())

  // Relations
  run            ReconciliationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  policy         Policy             @relation(fields: [policyId], references: [id], onDelete: Cascade)
  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  exception      PaymentException?  @relation(fields: [exceptionId], references: [id], onDelete: SetNull)

  @@map("reconciliation_records")
}

model PaymentException {
  id                      String            @id @default(cuid())
  exceptionNumber         String            @unique
  reconciliationRecordId  String?
  invoiceId               String
  paymentId               String?
  policyId                String
  type                    ExceptionType
  expectedAmount          Decimal           @db.Decimal(12, 2)
  actualAmount            Decimal           @db.Decimal(12, 2)
  difference              Decimal           @db.Decimal(12, 2)
  severity                ExceptionSeverity
  status                  ExceptionStatus   @default(OPEN)
  assignedToId            String?
  description             String?
  resolvedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Relations
  invoice                 Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment                 Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  policy                  Policy              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  assignedTo              User?               @relation("AssignedExceptions", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes                   ExceptionNote[]
  timeline                ExceptionTimelineEvent[]
  aiAnalyses              AIAnalysis[]
  aiConversations         AIConversation[]
  reconciliationRecords   ReconciliationRecord[]

  @@map("payment_exceptions")
}

model ExceptionNote {
  id          String   @id @default(cuid())
  exceptionId String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  // Relations
  exception   PaymentException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exception_notes")
}

model ExceptionTimelineEvent {
  id          String            @id @default(cuid())
  exceptionId String
  userId      String?
  eventType   TimelineEventType
  description String
  createdAt   DateTime          @default(now())

  // Relations
  exception   PaymentException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("exception_timeline_events")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  // Relations
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model AIAnalysis {
  id           String         @id @default(cuid())
  exceptionId  String
  analysisType AIAnalysisType
  prompt       String
  response     Json
  model        String
  createdAt    DateTime       @default(now())

  // Relations
  exception    PaymentException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

model AIConversation {
  id          String   @id @default(cuid())
  exceptionId String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exception   PaymentException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  createdAt      DateTime      @default(now())

  // Relations
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}
